    <string name="welcome_to_himma">Welcome to Himma</string>
    <string name="meals_and_calories_water_fasting">Meals and calories, water, fasting, medicine reminders, gym workouts, steps and your weight, in one calm app.</string>
    <string name="everything_stays_on_your_phone">Everything stays on your phone. There is no account and nothing is sent anywhere.</string>
    <string name="where_your_data_lives">Where your data lives</string>
    <string name="himma_keeps_plain_files_you">Himma keeps plain files you can open in any editor.</string>
    <string name="they_are_in_together_with">They are in %1$s, together with your other Zimam apps.</string>
    <string name="they_are_in_the_app">They are in the app\'s private folder now. Allow All files access and Himma moves a verified copy to Zimam/Himma on your phone, so your files survive a reinstall and sit next to the other Zimam apps. The old copy is kept until you remove it.</string>
    <string name="add_a_medicine_with_its">Add a medicine with its times and days and Himma tells you when a dose is due. Mark it Taken or Skip right from the notification.</string>
    <string name="android_asks_once_to_show">Android asks once to show notifications. If exact alarms are not allowed, a reminder can come a few minutes late.</string>
