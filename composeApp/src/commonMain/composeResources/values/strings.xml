    <string name="note_1">A Home page with today at a glance and shortcuts.</string>
    <string name="note_2">Medicine reminders: times, days, and Taken or Skip on the notification.</string>
    <string name="note_3">Your data can live in one visible Zimam/Himma folder (allow All files access).</string>
    <string name="note_4">A short tour on first install and this note after each update.</string>
    <string name="note_5">A richer Home: rings, a macro bar, 7-day charts and a weekly summary.</string>
    <string name="note_6">Gym: routines, workouts with every set, personal bests and a rest timer.</string>
    <string name="note_7">Steps from the phone\'s step counter, a weight log with a trend, and meal templates.</string>
    <string name="note_8">Light, Dark or System theme.</string>
    <string name="note_9">A new look: warm surfaces, a soft orange glow, rounded cards and the diamond accent.</string>
    <string name="note_10">A new About page.</string>
    <string name="note_11">Himma now speaks Arabic, with a right-to-left layout. Choose the language in Settings.</string>
    <string name="note_12">Numbers can be shown in Arabic-Indic digits.</string>
    <string name="note_13">Today, Meals, Water and Fasting.</string>
    <string name="note_14">A new app icon: a rising peak with a diamond.</string>
